# MySQL connection string used by Prisma (and by docker-compose's mysql service)
DATABASE_URL="mysql://erp_bridge_user:change_me@localhost:3306/erp_bridge"

# Root credentials for the docker-compose MySQL container
DB_NAME=erp_bridge
DB_USERNAME=erp_bridge_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root

# JWT signing secret - use a long random string in production
JWT_SECRET=change-this-super-secret-key-min-32-chars-long-for-hs256
JWT_EXPIRATION_SECONDS=86400

# AES-256 master key used to encrypt connector passwords at rest
CONNECTOR_ENCRYPTION_KEY=change-this-aes-encryption-master-key

# OpenRouter API key used by the AI auto-map feature (optional - get one free at openrouter.ai/keys)
GEMINI_API_KEY=

# Frontend origin allowed to call this API (CORS). "*" is fine for local dev.
FRONTEND_ORIGIN=*

# Used by the frontend to reach this backend
VITE_API_BASE_URL=http://localhost:8080/api/v1
