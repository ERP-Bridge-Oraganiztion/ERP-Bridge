# MySQL connection string (PlanetScale, Neon-for-MySQL, Railway, etc.)
# PlanetScale example: mysql://user:pass@host/dbname?sslaccept=strict
DATABASE_URL="mysql://user:password@host:3306/erp_bridge"

# JWT signing secret - use a long random string in production
JWT_SECRET="change-this-super-secret-key-min-32-chars-long-for-hs256"
JWT_EXPIRATION_SECONDS=86400

# AES-256 master key used to encrypt connector passwords at rest
CONNECTOR_ENCRYPTION_KEY="change-this-aes-encryption-master-key"

# OpenRouter/Gemini API key used by the AI auto-map feature (optional)
GEMINI_API_KEY=""

# The deployed URL of the Vite/React frontend, for CORS.
# Use "*" while testing, then lock it down to the real frontend URL.
FRONTEND_ORIGIN="*"
